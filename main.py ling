# --- CORE INTELLIGENCE ENGINE ---
def get_market_analysis(symbol):
    try:
        # Fetching 15m and Daily data
        df_15m = yf.download(symbol, period='5d', interval='15m')
        if df_15m.empty: return None

        # Advanced Indicators Logic
        close = df_15m['Close'].iloc[-1]
        high_20 = df_15m['High'].rolling(20).max().iloc[-1]
        low_20 = df_15m['Low'].rolling(20).min().iloc[-1]
        
        # RSI Calculation
        delta = df_15m['Close'].diff()
        gain = (delta.where(delta > 0, 0)).rolling(14).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(14).mean()
        rs = gain / loss
        rsi = 100 - (100 / (1 + rs)).iloc[-1]
        
        # Entry, SL and Target Logic
        entry = round(float(high_20), 2)
        sl = round(float(low_20), 2)
        risk = entry - sl
        t1 = round(entry + (risk * 1.5), 2)
        t2 = round(entry + (risk * 3), 2)
        
        # AI Confidence Score
        score = 40
        if close > entry: score += 30
        if 40 < rsi < 65: score += 20
        if df_15m['Volume'].iloc[-1] > df_15m['Volume'].mean(): score += 10
        
        return {
            "price": round(float(close), 2), "entry": entry, "sl": sl,
            "t1": t1, "t2": t2, "rsi": round(float(rsi), 2), 
            "score": min(score, 100), "df": df_15m
        }
    except:
        return None

